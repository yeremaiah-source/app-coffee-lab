# Copiá este archivo a .env y completá los valores reales.
# Nunca subas el archivo .env de verdad a git.

# Connection string de tu Postgres gratuito (Neon, Supabase, Railway...)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# String largo y random, distinto en cada entorno. Ejemplo para generar uno:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplazar-por-un-valor-random-largo"

PORT=4000

# Orígenes permitidos por CORS, separados por coma (sin barra final).
# En producción es OBLIGATORIO completarlo con el dominio real de tu
# frontend (ej. Netlify) — si queda vacío, la API acepta pedidos desde
# cualquier sitio, lo cual solo es aceptable en desarrollo local.
# Ejemplo: FRONTEND_ORIGIN=https://tu-app.netlify.app
FRONTEND_ORIGIN=

# Envío de emails de "olvidé mi contraseña". Mientras estas variables
# queden vacías, el link de recuperación se imprime en los logs del
# servidor en vez de enviarse por email — sirve para probar el flujo,
# pero antes de hacer pública la app hay que completarlas de verdad.
#
# La forma más simple si ya tenés Gmail: activá la verificación en dos
# pasos en myaccount.google.com/security, después andá a
# myaccount.google.com/apppasswords y generá una "contraseña de
# aplicación" — esa es la que va en EMAIL_PASS (no tu contraseña normal
# de Gmail).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Subida de imágenes (foto de perfil, fotos en publicaciones de la
# comunidad) vía Cloudinary — tiene un plan gratuito generoso, no pide
# tarjeta. Creá una cuenta en cloudinary.com, y en el Dashboard vas a
# ver estos tres valores ya armados para copiar.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
