generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  usuario
  barista
  administrador
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String?   @unique
  avatarUrl          String?
  passwordHash       String
  role               Role      @default(usuario)
  createdAt          DateTime  @default(now())
  resetToken         String?   @unique
  resetTokenExpires  DateTime?

  extractions    Extraction[]
  recipes        Recipe[]
  coffees        Coffee[]
  communityPosts CommunityPost[]
  comments       Comment[]
  loginEvents    LoginEvent[]
  notifications  Notification[]
  experimentos   Experimento[]
}

// Laboratorio de experimentación: hipótesis → variable modificada →
// resultado esperado vs. resultado real → conclusión. Es privado de
// cada usuario (su propio cuaderno de laboratorio), no público como
// las recetas.
model Experimento {
  id                  String   @id @default(uuid())
  user                User     @relation(fields: [userId], references: [id])
  userId              String
  hipotesis           String
  variableModificada  String
  variablesConstantes String?
  resultadoEsperado   String?
  resultadoReal       String?
  conclusion          String?
  estado              String   @default("en_curso")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Registro de accesos — usado por el panel de administrador para ver
// actividad de inicios de sesión (fecha, IP, dispositivo).
model LoginEvent {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

// Auditoría de acciones administrativas sensibles: quién hizo qué y
// cuándo. Nunca guarda contraseñas ni tokens, solo una descripción de
// la acción.
model AdminAuditLog {
  id            String   @id @default(uuid())
  adminId       String
  adminUsername String
  accion        String
  detalle       String?
  createdAt     DateTime @default(now())
}

// Notificaciones reales: se generan cuando alguien comenta tu
// publicación o duplica una receta tuya.
model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  tipo      String
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Extraction {
  id                  String   @id @default(uuid())
  user                User     @relation(fields: [userId], references: [id])
  userId              String
  metodo              String
  cafe                String?
  molienda            String?
  dosisG              Float
  aguaG               Float
  ratio               String
  tiempoSeg           Int?
  temperaturaC        Float?
  tds                 Float?
  tdsEstimado         Boolean  @default(false)
  tdsRangoMin         Float?
  tdsRangoMax         Float?
  tdsConfianza        Float?
  tdsConfianzaLabel   String?
  ey                  Float?
  categoria           String?
  recomendacion       String?
  notas               String?
  dulzor              Int?
  acidez              Int?
  cuerpo              Int?
  amargor             Int?
  createdAt           DateTime @default(now())

  communityPost CommunityPost?
}

// Calibración estadística del motor de estimación de TDS: guarda, por
// método de preparación, el sesgo promedio observado entre lo que el
// modelo heurístico predice y lo que un refractómetro real midió. Se
// actualiza de forma incremental cada vez que alguien carga un TDS
// medido — así el motor se ajusta solo con datos reales de uso, sin
// reentrenar nada manualmente.
model TdsCalibration {
  metodo          String   @id
  muestras        Int      @default(0)
  sesgoPromedio   Float    @default(0)
  actualizadoEn   DateTime @updatedAt
}

model Recipe {
  id               String   @id @default(uuid())
  author           User     @relation(fields: [authorId], references: [id])
  authorId         String
  nombre           String
  metodo           String
  cafe             String?
  molienda         String?
  dosisG           Float?
  aguaG            Float?
  temperaturaC     Float?
  ratio            String?
  tiempoSeg        Int?
  pasos            String?
  notas            String?
  version          Int      @default(1)
  resultados       String?
  parentRecipeId   String?
  parentRecipe     Recipe?  @relation("RecipeVersions", fields: [parentRecipeId], references: [id])
  versiones        Recipe[] @relation("RecipeVersions")
  createdAt        DateTime @default(now())
}

model Coffee {
  id             String   @id @default(uuid())
  addedBy        User     @relation(fields: [addedById], references: [id])
  addedById      String
  nombre         String
  origen         String?
  pais           String?
  region         String?
  productor      String?
  variedad       String?
  proceso        String?
  altitudMsnm    Int?
  tueste         String?
  fechaTueste    DateTime?
  notasSensoriales String?
  createdAt      DateTime @default(now())
}

model CommunityPost {
  id           String     @id @default(uuid())
  extraction   Extraction @relation(fields: [extractionId], references: [id])
  extractionId String     @unique
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  descripcion  String?
  fotoUrl      String?
  createdAt    DateTime   @default(now())

  comments Comment[]
}

model Comment {
  id        String        @id @default(uuid())
  post      CommunityPost @relation(fields: [postId], references: [id])
  postId    String
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  texto     String
  createdAt DateTime      @default(now())
}
